# ChargeGuard central system, built natively on IBM Z (s390x).
#   bash setup_chargeguard.sh            (trains the model and writes artifacts/ first)
#   podman build -t chargeguard -f Containerfile .
#   podman run -d --name chargeguard --network host -v chargeguard-data:/var/lib/chargeguard chargeguard
# Granite runs as a separate llama.cpp server; point CHARGEGUARD_LLM_URL at it.
FROM docker.io/library/ubuntu:24.04

# numpy/scipy/scikit-learn have no s390x wheels on PyPI: use Ubuntu's native builds.
# libzdnn0 is IBM's library for the on-chip AI accelerator, used by Snap ML.
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      python3 python3-venv python3-pip python3-numpy python3-scipy python3-sklearn python3-pandas \
      python3-joblib libzdnn0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv --system-site-packages /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir fastapi uvicorn websockets snapml

WORKDIR /app
COPY chargeguard ./chargeguard
COPY artifacts/risk.joblib artifacts/tariff.json ./artifacts/
COPY results ./results

ENV CHARGEGUARD_DB=/var/lib/chargeguard/chargeguard.db \
    CHARGEGUARD_KEY_FILE=/var/lib/chargeguard/key \
    CHARGEGUARD_LLM_URL=http://127.0.0.1:8081 \
    PYTHONUNBUFFERED=1
RUN mkdir -p /var/lib/chargeguard && chown 1000:1000 /var/lib/chargeguard
VOLUME /var/lib/chargeguard
EXPOSE 8095
HEALTHCHECK --interval=30s --timeout=5s CMD python3 -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8095/healthz',timeout=4)"
USER 1000
CMD ["/opt/venv/bin/uvicorn", "chargeguard.app.main:app", "--host", "127.0.0.1", "--port", "8095"]
